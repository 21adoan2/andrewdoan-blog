---
import '../styles/global.css';

interface Props {
  title: string;
  isPost?: boolean;
}

const { title, isPost = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme =
          stored ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <header class="menu">
        <a href="/" class="site-title">andrew doan</a>
        <div class="spacer"></div>
        <button class="theme-toggle" type="button" aria-label="Toggle theme">
          <svg class="theme-glyph theme-glyph-light" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-glyph theme-glyph-dark" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
          </svg>
        </button>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="footer">
        {isPost ? (
          <p>
            my little corner of the internet.
            from an early career product designer who loves complex problems & emerging tech.
            view my work <a href="https://21adoan2.github.io/Portfolio2024/" target="_blank" rel="noopener">here</a>.
            back to <a href="/">blog home</a>.
          </p>
        ) : (
          <p>
            my little corner of the internet.
            from an early career product designer who loves complex problems & emerging tech.
            view my work <a href="https://21adoan2.github.io/Portfolio2024/" target="_blank" rel="noopener">here</a>.
          </p>
        )}
      </footer>
    </div>

    <script>
      const btn = document.querySelector('.theme-toggle');
      btn?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
